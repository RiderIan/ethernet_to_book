# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y3 [get_cells dbg_hub/inst/BSCANID.u_xsdbm_id/SWITCH_N_EXT_BSCAN.u_bufg_icon_tck]
set_property LOC BUFGCTRL_X0Y6 [get_cells clks_rsts_inst/mmcm1_inst/inst/clkf_buf]
set_property LOC BUFGCTRL_X0Y0 [get_cells clks_rsts_inst/mmcm1_inst/inst/clkout1_buf]
set_property LOC BUFGCTRL_X0Y5 [get_cells clks_rsts_inst/mmcm0_inst/inst/clkf_buf]
set_property LOC BUFGCTRL_X0Y2 [get_cells clks_rsts_inst/mmcm0_inst/inst/clkout3_buf]
set_property LOC BUFGCTRL_X0Y1 [get_cells clks_rsts_inst/mmcm0_inst/inst/clkout2_buf]
set_property LOC BUFGCTRL_X0Y4 [get_cells clks_rsts_inst/bufg_clk_inst]

# Location of IO Primitives which is load of clock spine
set_property LOC IOB_X0Y89 [get_cells txClkOut_OBUF_inst]

# Location of clock ports
set_property LOC IOB_X1Y124 [get_ports clkIn]
set_property LOC IOB_X0Y74 [get_ports rxClkIn]

# Clock net "dbg_hub/inst/BSCANID.u_xsdbm_id/itck_i" driven by instance "dbg_hub/inst/BSCANID.u_xsdbm_id/SWITCH_N_EXT_BSCAN.u_bufg_icon_tck" located at site "BUFGCTRL_X0Y3"
#startgroup
create_pblock {CLKAG_dbg_hub/inst/BSCANID.u_xsdbm_id/itck_i}
add_cells_to_pblock [get_pblocks  {CLKAG_dbg_hub/inst/BSCANID.u_xsdbm_id/itck_i}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="dbg_hub/inst/BSCANID.u_xsdbm_id/itck_i"}]]]
resize_pblock [get_pblocks {CLKAG_dbg_hub/inst/BSCANID.u_xsdbm_id/itck_i}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0 CLOCKREGION_X0Y1:CLOCKREGION_X0Y1}
#endgroup

